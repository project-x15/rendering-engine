{
  "name": "@project-x15/rendering-engine",
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@9.5.0",
  "main": "./src/index.ts",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm build",
    "test": "node --import tsx --test test/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/*.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=html node --import tsx --test test/*.test.ts",
    "test:e2e": "pnpm exec playwright test --config playwright.config.ts",
    "test:install-browser": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@hono/node-server": "^2.0.0",
    "hono": "^4.0.0",
    "preact": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    }
  },
  "dependencies": {
    "preact-render-to-string": "^6.5.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.8",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "c8": "^11.0.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "sideEffects": false,
  "changelog": [
    "Removed codename = \"holly_puff\" (Low)"
  ]
}